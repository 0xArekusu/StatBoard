{
  "name": "coach-assistant",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start": "expo start",
    "start-clean": "expo start -c",
    "rebuild": "npx expo prebuild --clean",
    "android": "expo run:android",
    "build-android-preview": "eas build --platform android --profile preview --clear-cache",
    "build-android-production": "eas build --platform android --profile production --clear-cache",
    "submit-android": "eas submit --platform android",
    "ios": "expo run:ios",
    "build-ios-preview": "eas build --platform ios --profile preview --clear-cache",
    "build-ios-production": "eas build --platform ios --profile production --clear-cache",
    "submit-ios": "eas submit --platform ios",
    "update-preview": "eas update --branch preview",
    "update-production": "eas update --branch production",
    "build-list": "eas build:list",
    "build-cancel": "eas build:cancel",
    "doctor": "npx expo-doctor",
    "install-fix": "npx expo install --fix",
    "info": "npx react-native info",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react-native": "~7.12.0",
    "@supabase/supabase-js": "^2.75.0",
    "expo": "~54.0.31",
    "expo-apple-authentication": "~8.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "^19.0.17",
    "expo-font": "~14.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-print": "~15.0.8",
    "expo-screen-orientation": "~9.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.3.1",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "13.15.0",
    "reanimated-color-picker": "^4.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@types/react-native-vector-icons": "^6.4.18",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@sentry/.*)"
    ]
  },
  "private": true
}
